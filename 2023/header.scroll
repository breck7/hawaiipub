importOnly
import ../settings.scroll
import ../style.scroll

replaceJs TODAY_NAME particle.root.get("date") ? particle.root.dayjs(particle.root.get("date")).format(`dddd`) : "TODAY_NAME"
replaceJs TODAYS_DATE particle.root.get("date") ? particle.root.dayjs(particle.root.get("date")).format(`M-D`) : "TODAYS_DATE"
replaceJs YESTERDAYS_DATE particle.root.get("date") ? particle.root.dayjs(particle.root.get("date")).subtract(1, "day").format(`M-D`) : "YESTERDAYS_DATE"
replaceJs MONTH_DAY particle.root.get("date") ? particle.root.dayjs(particle.root.get("date")).format(`MMMM D`) : "MONTH_DAY"

buildHtml
metaTags
theme gazette
homeButton /index.html
editButton

tags daily index

title Da Hawai'i Pub - TODAY_NAME, MONTH_DAY, 2023
description The print at home daily newspaper for residents of Honolulu, Hawai'i.
printTitle

/.gazette.css
/.scroll.css

* <div class="tagLine"> _The print at home daily newspaper for residents of Honolulu, Hawai'i. <span class="doNotPrint">PDF version.</span>_ </div>
 link pdfs/TODAYS_DATE.pdf PDF version

thinColumns 4
